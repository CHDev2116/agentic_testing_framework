{
    "version": "1.0.0",
    "environment": "replay_smoke",
    "model_settings": {
        "name": "Replay Smoke",
        "bit_depth": 4,
        "inference": {
            "backend": "simulated",
            "fallback_to_simulated": false
        }
    },
    "thresholds": {
        "min_sharpness": 20.0,
        "min_brightness": 40.0,
        "max_brightness": 220.0
    },
    "folders": {
        "input": "tests/fixtures/replay_smoke",
        "output": "results/replay_smoke",
        "logs": "logs/replay_smoke"
    },
    "runtime": {
        "oom_probability": 0.0,
        "max_retry": 1,
        "loopback_planner": {
            "mode": "simulated",
            "require_healthy_on_startup": false
        },
        "loopback_guard": {
            "min_brightness_gain": 4.0,
            "min_sharpness_gain": 1.0
        }
    },
    "quality_gate": {
        "target_pass_rate": 50.0
    },
    "eval_settings": {
        "conflict_strategy": "conservative",
        "auto_tag_conflicts": true
    }
}
