{
    "version": "1.2.0",
    "environment": "base",
    "metadata": {
        "device": "M4-MacBook-Pro",
        "author": "Cheryl"
    },
    "model_settings": {
        "name": "PixelQA-Llama-4bit",
        "bit_depth": 4,
        "quantization_format": "GGUF",
        "inference": {
            "backend": "simulated",
            "fallback_to_simulated": true,
            "ollama": {
                "host": "http://localhost:11434",
                "model": "llava:7b",
                "timeout_s": 45
            },
            "mock_api": {
                "url": "http://localhost:8080/infer",
                "timeout_s": 10,
                "api_key_env": "MOCK_INFER_API_KEY"
            },
            "llama_cpp": {
                "host": "http://127.0.0.1:8080",
                "endpoint": "/v1/chat/completions",
                "model": "local-model",
                "timeout_s": 45,
                "temperature": 0.0,
                "max_tokens": 256,
                "use_response_format": true
            }
        }
    },
    "thresholds": {
        "min_sharpness": 20.0,
        "min_brightness": 40.0,
        "max_brightness": 220.0,
        "timeout_ms": 5000
    },
    "folders": {
        "input": "test_images",
        "output": "results/base",
        "logs": "logs/base"
    },
    "runtime": {
        "oom_probability": 0.0
    },
    "quality_gate": {
        "target_pass_rate": 85.0
    },
    "eval_settings": {
        "conflict_strategy": "conservative",
        "weights": {
            "engine_weight": 0.6,
            "model_weight": 0.4
        },
        "auto_tag_conflicts": true
    }
}