{
    "version": "1.2.0",
    "environment": "dev",
    "metadata": {
        "device": "M4-MacBook-Pro",
        "author": "Cheryl"
    },
    "model_settings": {
        "name": "PixelQA-Llama-4bit",
        "bit_depth": 4,
        "quantization_format": "GGUF",
        "inference": {
            "backend": "llama_cpp"
        },
        "quantization_type": "Q4_K_M",
        "runtime_args": {
            "n_threads": 8,
            "n_gpu_layers": -1,
            "main_gpu": 0,
            "ctx_size": 2048,
            "batch_size": 512
        }
    },
    "thresholds": {
        "min_sharpness": 20.0,
        "min_brightness": 40.0,
        "max_brightness": 220.0,
        "timeout_ms": 5000
    },
    "folders": {
        "input": "test_images",
        "output": "results/dev",
        "logs": "logs/dev"
    },
    "runtime": {
        "oom_probability": 0.0
    },
    "quality_gate": {
        "target_pass_rate": 80.0
    },
    "eval_settings": {
        "conflict_strategy": "conservative",
        "weights": {
            "engine_weight": 0.6,
            "model_weight": 0.4
        },
        "auto_tag_conflicts": true
    }
}